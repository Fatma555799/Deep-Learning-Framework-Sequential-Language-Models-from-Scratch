class BigramLanguageModel(nn.Module):
  def __init__(self,vocab_size):
    super().__init__()
    self.token_embedding_table=nn.Embedding(vocab_size,n_embd)
    self.position_embedding_table=nn.Embedding(block_size,n_embd)
    self.blocks=nn.Sequential(block(n_embd,num_heads=n_head),
                              block(n_embd,num_heads=n_head),
                              block(n_embd,num_heads=n_head),
                              block(n_embd,num_heads=n_head))
    self.lm_head=nn.Linear(n_embd,vocab_size)
  def forward(self,idx,target=None):
    B,T=idx.shape #(B,T)
    tok_emb=self.token_embedding_table(idx) #(B,T,C)
    pos_emb=self.position_embedding_table(torch.arange(T,device=device)) #(T,C) position encoding
    x=tok_emb+pos_emb
    x=self.blocks(x)
    logits=self.lm_head(x) #(B,T,vocab_size)
    if target is None:
      loss=None
    else:
     B,T,C=logits.shape
     logits=logits.view(B*T,C)
     target=target.view(B*T)
     loss=F.cross_entropy(logits,target)
    return logits,loss

  def generate(self,idx,max_new_tokens):
    #idx is (B,T) indicies to the current context
    for _ in range(max_new_tokens):
      #crop idx to the last block_size context to work with positional embedding that have emedding for block size only
      idx_cond=idx[:,-block_size:]
      #use the paremater of the model to predict the next token
      logits,loss=self(idx_cond)
      #
      logits=logits[:,-1,:]
      probs=F.softmax(logits,dim=-1)
      idx_next=torch.multinomial(probs,num_samples=1)
      idx=torch.cat((idx,idx_next),dim=1)
    return idx

