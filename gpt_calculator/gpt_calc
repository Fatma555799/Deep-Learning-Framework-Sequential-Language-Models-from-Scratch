def generate_random_equation():
  while True:
    a = torch.randint(0, 10**n, (1,)).item()
    b = torch.randint(1, 10**n, (1,)).item()
    operation = torch.randint(0, 4, (1,)).item()
    if operation == 0:
        op = '+'
        c = str(a+b)
    elif operation == 1:
        op = '-'
        c = str(a-b)
    elif operation == 2:
        op = '*'
        c = str(a*b)
    else:
        op = '/'
        c = str('%.3f'%(a/b))
    equation_core = f"{a}{op}{b}={c[::-1]}"
    # Ensure the equation length is block_size + 1 for proper x, y token splitting
    required_length = block_size + 1
    if len(equation_core) < required_length:
        return equation_core.ljust(required_length)
    elif len(equation_core) == required_length:
        return equation_core
    # If it's longer, regenerate to fit within typical block sizes for this model


def get_batch():
  equations=[generate_random_equation() for _ in range(batch_size)]
  x_list = []
  y_list = []
  for eq in equations:
    tokens = encode(eq)
    x_tokens = tokens[:block_size]
    y_tokens = tokens[1:block_size+1]
    equal_idx=eq.index("=")
    y_tokens_masked=[y_tokens[i] if i>=equal_idx else -100  for i in range(block_size)]
    x_list.append(x_tokens)
    y_list.append(y_tokens_masked)
    X = torch.tensor(x_list, dtype=torch.long, device=device)
    Y = torch.tensor(y_list, dtype=torch.long, device=device)
  X,Y=X.to(device),Y.to(device)
  return X,Y
