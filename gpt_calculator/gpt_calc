class CausalSelfAttention(nn.Module):
  def __init__(self,n_head):
    super().__init__()
    self.c_attn=nn.Linear(n_embd,3*n_embd,bias=False)
    self.register_buffer('tril',torch.tril(torch.ones(block_size,block_size)))
    self.proj=nn.Linear(n_embd,n_embd)
    self.attn_dropout=nn.Dropout(dropout)
    self.resid_dropout=nn.Dropout(dropout)
  def forward(self,x):
    B,T,C=x.shape
    k,q,v=self.c_attn(x).split(n_embd,dim=2) #B,T,n_embd
    k=k.view(B,T,n_head,-1).transpose(1,2) #B,n_head,T,head_size
    q=q.view(B,T,n_head,-1).transpose(1,2) #B,n_head,T,head_size
    v=v.view(B,T,n_head,-1).transpose(1,2) #B,n_head,T,head_size
    wei=q @ k.transpose(-2,-1) *(1.0 / math.sqrt(k.size(-1)))
#every forward pass it is has diffrent number so it shaking so we make lr small
    wei=wei.masked_fill(self.tril[:T,:T]==0,float('-inf')) #trangiular mask for decoder
    wei=F.softmax(wei,dim=-1) #we make lr samll alse for it because if large num goes to it ,it will freeze the model
    wei=self.attn_dropout(wei)  #attention dropout
    out=wei @ v
    out=out.transpose(1,2).contiguous().view(B,T,C)
    out=self.resid_dropout(self.proj(out))  #resid dropout
    return out

class feedforward(nn.Module): #MLP
  def __init__(self,n_embd):
    super().__init__()
    self.net=nn.Sequential(
        nn.Linear(n_embd,n_head*n_embd),
        nn.ReLU(),
        nn.Linear(n_head*n_embd,n_embd), #projection
        nn.Dropout(dropout)
        )
  def forward(self,x):
    return self.net(x)

class block(nn.Module):
  def __init__(self,n_embd,num_heads):
    super().__init__()
    head_size=n_embd//num_heads
    self.sa=MultiheadAttention(num_heads,head_size)
    # self.sa=CausalSelfAttention(num_heads)
    self.ffwd=feedforward(n_embd)
    self.l1=nn.LayerNorm(n_embd) #B,T acts like B it is out normalization for each token depend only on feature of this token (C level)
    self.l2=nn.LayerNorm(n_embd)
  def forward(self,x):
    #norm -->multihead attention -->norm-->feedforward    and there is residual
    x=x+self.sa(self.l1(x)) #residual connection
    x=x+self.ffwd(self.l2(x))
    return x


class LayerNorm:
  def __init__(self, dim, eps=1e-5):
    self.eps = eps
    # parameters (trained with backprop)
    self.gamma = torch.ones(dim)
    self.beta = torch.zeros(dim)

  def __call__(self, x):
    # calculate the forward pass
    xmean = x.mean(1, keepdim=True) # batch mean
    xvar = x.var(1, keepdim=True) # batch variance
    xhat = (x - xmean) / torch.sqrt(xvar + self.eps) # normalize to unit variance
    self.out = self.gamma * xhat + self.beta
    return self.out

  def parameters(self):
    return [self.gamma, self.beta]
